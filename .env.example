# ---------------------------------------------------------------------------
# CareLink-AI environment configuration (Step 9 — production integration foundation)
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# SECURITY RULES (read before editing):
# - Only `VITE_*` variables are exposed to the browser bundle by Vite.
# - `VITE_*` variables must contain ONLY values safe to publish publicly.
#   NEVER put service-role keys, secret keys, or private tokens in `VITE_*`.
# - Server-only secrets (e.g. a Cloudinary API secret, an LLM bearer token) are
#   intentionally NOT defined here as `VITE_*`. They must live server-side and be
#   consumed by a server/API-adapter boundary that the browser never sees.
# - Every variable below is OPTIONAL. The app runs fully on mock data when any
#   credential is missing, and never crashes because a key is absent.
# ---------------------------------------------------------------------------

# --- App / runtime --------------------------------------------------------
# Vite mode is provided by Vite automatically; no env var needed.
# Base URL for the (future) CareLink API adapter. Browser-safe. Leave as /api.
VITE_API_BASE_URL=/api

# --- xAI Grok (server-side only) -----------------------------------------
# These values are read by the Supabase Edge Function, never by the browser.
# For local Supabase Functions, pass this file using --env-file .env.
#
# SETUP (live AI is optional — without it the assistant runs in clearly-labelled
# demo mode and never claims a demo answer came from a live model):
#   1. Create an xAI API key at https://console.x.ai (account + billing required).
#   2. supabase functions deploy ai-gateway
#   3. supabase secrets set XAI_API_KEY=<key> XAI_MODEL=<model-id>
#   4. The browser must also have VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY so the
#      authenticated ai-gateway call can be made.
#   The key must NEVER be placed in a VITE_* variable — that would ship it to the
#   browser. Rotate it in the xAI console and re-run `supabase secrets set` if it leaks.
XAI_API_KEY=your_actual_key_goes_here
XAI_MODEL=your_verified_supported_model_id

# --- Medicine image analysis (vision) — SERVER-SIDE ONLY --------------------
# Medicine-photo analysis needs a VISION-capable model. It runs in a SEPARATE
# Edge Function (`medicine-vision`) because the chat gateway is text-only: it
# receives attachment metadata, never pixels. Without these, a medicine photo
# shows an honest "image analysis not configured" state — it is NEVER replaced
# with a demo/mock medicine identity.
#
# SETUP:
#   1. supabase functions deploy medicine-vision
#   2. supabase secrets set XAI_VISION_MODEL=<vision-capable-model-id>
#      (XAI_API_KEY above is reused; do not create a second key.)
#   3. Verify the model actually accepts image content parts before going live.
# The client sends only the (downscaled) image bytes + the user's language.
XAI_VISION_MODEL=your_verified_vision_capable_model_id

# Optional legacy app-owned intent-classification service only (not the chat
# gateway). Never point this at a provider URL or put a provider key in VITE_*.
VITE_AI_PROVIDER_BASE_URL=
# --- Admin gateway (browser-safe, caller-JWT authenticated) ------------------
# URL of the Supabase edge function that enforces super-admin-only guarded actions
# (roles, provider membership, verification, media moderation). Browser-safe..
# Secrets ride only in the caller's Supabase session (JWT); bootstrap additionally requires
# an operator-provided x-bootstrap-secret that is never stored in the client bundle..
VITE_ADMIN_GATEWAY_URL=

# --- Supabase (browser-safe, anon only) ----------------------------------
# The Supabase project URL + *anon* public key are safe for the browser.
# NEVER use the service_role key here — it is privileged and server-only.
#
# Step 10: apply the schema + RLS migrations in supabase/migrations/ to your
# project before enabling Supabase Auth. RLS is mandatory — without it the
# anon key would expose all rows. See supabase/migrations/0001 + 0002.
#
# Also add this app's origin to the Supabase Auth "Redirect URLs" allow-list
# (Dashboard → Authentication → URL Configuration) so the password-recovery
# email can return the user to /reset-password on this deployment.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLISHABLE_KEY
# --- Cloudinary (browser-safe, unsigned upload preset only) --------------
# Cloud name + an unsigned upload preset are the only Cloudinary values safe
# for the browser. The API secret/signature stays server-side.
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
VITE_CLOUDINARY_UNSIGNED_UPLOAD_PRESET=YOUR_UNSIGNED_UPLOAD_PRESET

# --- Maps / geocoding / directions / places -----------------------------
# Google Places API (New) key for text search and place details. Enable Places
# API (New) and billing in Google Cloud. This browser key is public: restrict it
# to your deployed/dev HTTP referrers and to Places API only, and set quota alerts.
#
# SETUP (live Places discovery is optional — the app works without it):
#   1. Google Cloud Console → APIs & Services → Library → enable "Places API (New)".
#   2. Enable billing on the project (Places requires a billing account).
#   3. Credentials → Create API key → Application restrictions = HTTP referrers
#      (list your dev + production origins) and API restrictions = Places API (New).
#   4. Set the key below and restart the dev server.
#   5. Verify: the Hospitals page notice changes from "not configured" to the
#      registry/Places wording, and `npm run verify:readiness` shows CONFIGURED.
#   NOTE: Google Maps DIRECTIONS deep-links (the "Directions" buttons) need NO key
#   and work in every mode — they use the universal maps/dir URL.
VITE_GOOGLE_MAPS_API_KEY=

# Geoapify is the live routing/geocoding provider used by the real maps adapters
# (directions + geocode search + reverse geocode). Browser-safe public key only;
# lock it down by domain/referrer in the Geoapify console. Leave empty to use
# the mock/local development adapter.
VITE_GEOAPIFY_API_KEY=

# Development-only demo auth: enabled only when Vite is running in DEV mode and
# this flag is explicitly set to true. Never enabled in production builds.
VITE_ENABLE_DEV_TEST_AUTH=false

# --- Healthcare search providers (hospital / pharmacy / lab) -------------
# These are optional server-backed adapters. Browser-safe base URLs only; any
# secret credentials belong to the server adapter, not the client.
VITE_HOSPITAL_SEARCH_BASE_URL=
VITE_PHARMACY_SEARCH_BASE_URL=
VITE_LAB_SEARCH_BASE_URL=

# --- Document processing + medicine intelligence -------------------------
# Server-backed OCR / document analysis + medicine recognition endpoints.
# Browser-safe base URLs only. Never embed private keys here.
VITE_DOCUMENT_ANALYSIS_BASE_URL=
VITE_MEDICINE_INTELLIGENCE_BASE_URL=

# --- Development-only authentication test mode (Phase 9) ------------------
# When set to `true`, a DEV build (`npm run dev`) accepts the isolated test
# identities (e.g. abcd / 1234) shown on the login page. This is an explicit
# opt-in that ONLY works in a development build: production builds ignore it
# completely (the gate also requires import.meta.env.DEV === true). Test users
# carry NO roles and cannot reach admin surfaces. Leave empty/absent normally.
VITE_ENABLE_DEV_TEST_AUTH=
