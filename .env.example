# ---------------------------------------------------------------------------
# CareLink-AI environment configuration (Step 9 — production integration foundation)
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# SECURITY RULES (read before editing):
# - Only `VITE_*` variables are exposed to the browser bundle by Vite.
# - `VITE_*` variables must contain ONLY values safe to publish publicly.
#   NEVER put service-role keys, secret keys, or private tokens in `VITE_*`.
# - Server-only secrets (e.g. a Cloudinary API secret, an LLM bearer token) are
#   intentionally NOT defined here as `VITE_*`. They must live server-side and be
#   consumed by a server/API-adapter boundary that the browser never sees.
# - Every variable below is OPTIONAL. The app runs fully on mock data when any
#   credential is missing, and never crashes because a key is absent.
# ---------------------------------------------------------------------------

# --- App / runtime --------------------------------------------------------
# Vite mode is provided by Vite automatically; no env var needed.
# Base URL for the (future) CareLink API adapter. Browser-safe. Leave as /api.
VITE_API_BASE_URL=/api

# --- AI provider ----------------------------------------------------------
# Browser-safe public label only. The real AI/LLM secret stays server-side.
# Set to a non-empty value to indicate a real AI provider backend is configured
# at VITE_AI_PROVIDER_BASE_URL and the app should attempt REAL mode for AI.
VITE_AI_PROVIDER_BASE_URL=

# --- Supabase (browser-safe, anon only) ----------------------------------
# The Supabase project URL and *anon* public key are safe for the browser.
# NEVER use the service_role key here — it is privileged and server-only.
#
# Step 10: apply the schema + RLS migrations in supabase/migrations/ to your
# project before enabling Supabase Auth. RLS is mandatory — without it the
# anon key would expose all rows. See supabase/migrations/0001 + 0002.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# --- Cloudinary (browser-safe, unsigned upload preset only) --------------
# Cloud name + an unsigned upload preset are the only Cloudinary values safe
# for the browser. The API secret/signature stays server-side.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UNSIGNED_UPLOAD_PRESET=

# --- Maps / geocoding / directions / places -----------------------------
# Google Maps JS API key is browser-restricted in production via HTTP referrer
# rules; it is acceptable as a VITE_ var but must be locked down in the cloud
# console. Leave empty to use the mock/local development adapter.
VITE_GOOGLE_MAPS_API_KEY=

# --- Healthcare search providers (hospital / pharmacy / lab) -------------
# These are optional server-backed adapters. Browser-safe base URLs only; any
# secret credentials belong to the server adapter, not the client.
VITE_HOSPITAL_SEARCH_BASE_URL=
VITE_PHARMACY_SEARCH_BASE_URL=
VITE_LAB_SEARCH_BASE_URL=

# --- Document processing + medicine intelligence -------------------------
# Server-backed OCR / document analysis + medicine recognition endpoints.
# Browser-safe base URLs only. Never embed private keys here.
VITE_DOCUMENT_ANALYSIS_BASE_URL=
VITE_MEDICINE_INTELLIGENCE_BASE_URL=
